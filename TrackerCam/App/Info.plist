<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleDisplayName</key>
    <string>TrackerCam</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- Permissions (plan §5). -->
    <key>NSCameraUsageDescription</key>
    <string>TrackerCam uses the camera to record and automatically frame your subject.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>TrackerCam can save your recordings to your photo library.</string>

    <!-- High-refresh ProMotion preview (plan §5). -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <!-- Native-resolution launch screen. Without UILaunchScreen, iOS runs the app in scaled
         compatibility mode and the whole UI appears zoomed in / large-font. These keys live here
         (authoritative) rather than as INFOPLIST_KEY_* build settings, which only take effect when
         GENERATE_INFOPLIST_FILE is YES — it is not, so those settings were being ignored. -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Landscape-first capture (plan §4/§12); portrait secondary. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- SwiftUI (WindowGroup) scene support. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>


    <!-- Background recording is explicitly unsupported (plan §5). No UIBackgroundModes. -->
</dict>
</plist>
